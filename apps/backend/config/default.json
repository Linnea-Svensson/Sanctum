{
  "host": "localhost",
  "port": 3030,
  "origins": [
    "http://localhost:5173",
    "https://www.sanctumkiropraktik.se",
    "https://sanctumkiropraktik.se"
  ],
  "paginate": {
    "default": 10,
    "max": 50
  },
  "authentication": {
    "entity": "user",
    "service": "users",
    "secret": "CHANGE_ME_VIA_FEATHERS_AUTH_SECRET_ENV",
    "authStrategies": ["jwt", "local"],
    "jwtOptions": {
      "header": { "typ": "access" },
      "audience": "https://sanctum.local",
      "issuer": "sanctum",
      "algorithm": "HS256",
      "expiresIn": "1d"
    },
    "local": {
      "usernameField": "email",
      "passwordField": "password"
    }
  },
  "sqlite": {
    "client": "sqlite3",
    "connection": {
      "filename": "./data/sanctum.sqlite"
    },
    "useNullAsDefault": true
  }
}
