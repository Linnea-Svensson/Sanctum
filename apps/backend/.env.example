# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Port the Feathers API listens on
PORT=3030

# Secret used to sign JWTs. Use a long random string in production.
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
FEATHERS_AUTH_SECRET=replace-with-a-long-random-secret

# Admin user that `npm run seed:admin` creates / updates.
ADMIN_EMAIL=admin@sanctum.local
ADMIN_PASSWORD=replace-with-a-strong-password
