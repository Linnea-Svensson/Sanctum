# Copy to `.env` (or `.env.local`) to point the frontend at a non-default API.
# Defaults to http://localhost:3030 when unset.
#
# In production (Vercel) this MUST be set to the HTTPS URL of the deployed
# backend, e.g. VITE_API_URL=https://sanctum-api.up.railway.app
# A plain http:// URL will be blocked by the browser as mixed content.
VITE_API_URL=http://localhost:3030
